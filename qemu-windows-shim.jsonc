{
  // This will be at the start of the bazel file.
  "bazel_prefix": "load(\"//build/bazel/rules:windows_resources.bzl\", \"windows_resources\") \nfilegroup(name = \"hw-display-virtio-gpu.lib\", srcs = [\":hw-display-virtio-gpu\"], output_group = \"interface_library\", visibility = [\"//visibility:private\"],) \ncc_import(name = \"hw-display-virtio-gpu.if\", interface_library = \":hw-display-virtio-gpu.lib\", shared_library = \":hw-display-virtio-gpu\", visibility = [\"//visibility:public\"],)",
  "shims": [
    {
      "target": "generate_shared_QAPI_source_files",
      "shims": {
        "+outs": ["qapi/qapi-features.h", "qapi/qapi-features.c"],
        "cmd": "$(location :qapi-gen) -o $(RULEDIR)/qapi -b $(location qapi/qapi-schema.json)",
        "cmd_bat": "$(location :qapi-gen) -o $(RULEDIR)/qapi -b $(location qapi/qapi-schema.json)"
      }
    },
    {
      "target": "generate_config-poison_h",
      "shims": {
        // TODO: It would be nice if we could generalize this in the generator
        "cmd": "$(location :make-config-poison) $(SRCS) > $(location config-poison.h)",
        "cmd_bat": "$(location :make-config-poison) $(SRCS) > $(location config-poison.h)"
      }
    },
    {
      "target": "keymap-gen",
      "shims": {
        "srcs": [
          "subprojects/keycodemapdb/tools/keymap-gen.py"
        ]
      }
    },
    {
      "target": "qemu-system-.*",
      "shims": {
        "_bzl_type": "cc_interface_binary",
        "+deps": [
          "//hardware/generic/goldfish/emulator/crashreport:init",
          "//hardware/generic/goldfish/android/system"
        ],
        // Replace standard launcher with google launcher
        "-srcs": ["system/main.c"],
        "+srcs": [
          "google/system/aemu_main.cpp",
          "google/system/aemu_plugins.c"
        ],
        "-deps": [
          // We will bring our own version of libmodinfo, so strip it!
          ":libmodinfo-.*"
        ],
        "visibility": ["//visibility:public"]
      }
    },
    {
      "target": "qemu-system-aarch64",
      "shims": {
        "win_def_file": "platform/windows-amd64/qemu-system-aarch64.def"
      }
    },
    {
      "target": "qemu-system-riscv64",
      "shims": {
        "win_def_file": "platform/windows-amd64/qemu-system-riscv64.def"
      }
    },
    {
      "target": "qemu-system-x86_64",
      "shims": {
        "win_def_file": "platform/windows-amd64/qemu-system-x86_64.def"
      }
    },
    {
      "target": "^hw-display-virtio-gpu$",
      "shims": {
        "win_def_file": "platform/windows-amd64/hw-display-virtio-gpu.def"
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "py_binary",
        // For some reason bazel on windows is not able to figure out
        // the import path, so let's just explicitly add it.
        "imports": [
          "scripts"
        ]
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "cc_shared_library",
        // xs4all!
        "visibility": ["//visibility:public"]
      }
    },
    {
      "target": "libqemuutil",
      "shims": {
        "-srcs": [
          // These are instead added to our libprintstub in the stubs/meson.build
          // so remove them from libqemuutil (not sure why they are still here).
          "stubs/monitor-core.c",
          "stubs/error-printf.c"
        ]
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "cc_library|cc_binary",
        // xs4all!
        "visibility": ["//visibility:public"],
        // Remove our compat libs if present
        "-hdrs": [
          ".*subprojects.*"
        ],
        "+copts": [
          "-Wno-constant-conversion",
          "-Wno-macro-redefined",
          "-Wno-invalid-noreturn",
          "-Wno-bitfield-constant-conversion",
          "-Wno-int-to-void-pointer-cast",
          "-Wno-unused-command-line-argument",
          "-Wno-undef",
          "-Wno-microsoft-enum-forward-reference",
          "-Wno-microsoft-include",
          "-Wno-deprecated-declarations",
          "-fms-extensions",
          "-march=native",
          // QEMU does not support NDEBUG (see qemu/osdep.h), so explicitly disable it
          "-UNDEBUG"
        ],
        // We need a compat layer for some windows magic.
        "+deps": [
          "//third_party/qemu/google/compat/windows:compat"
        ]
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "cc_library|cc_binary|cc_interface_binary",
        "-hdrs": ["include/.*", "platform/.*", "qapi/.*"],
        "-srcs": ["include/.*", "platform/.*", "qapi/.*\\.h"],
        "-includes": ["include", "platform/.*", "trace"],
        "+deps": [":qemu-headers"]
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "cc_library",
        "alwayslink": 1
      }
    },
    {
      "target": "libqemuutil|libprintstub",
      "shims": {
        "alwayslink": 0
      }
    },
    {
      "target": "hw-display-virtio-gpu-pci|hw-display-virtio-gpu|hw-display-virtio-vga|hw-display-virtio-gpu-rutabaga|hw-display-virtio-gpu-pci-rutabaga",
      "shims": {
        "+deps": [
          ":qemu-system-x86_64.if"
        ]
      }
    },
    {
      "target": "hw-display-virtio-gpu-rutabaga",
      "shims": {
        "+deps": [
          ":hw-display-virtio-gpu.if"
        ]
      }
    }
  ],
  // These are the bazel mappings we are going to use for
  // external dependencies. For every pkg config dependency
  // you will need to provide a bazel target
  "external_deps": {
    "glib-2.0": [
      "@glib//:glib-static",
      "@glib//:gmodule-static"
    ],
    "gmodule-export-2.0": [
      "@glib//:gmodule-static"
    ],
    "zlib": [
      "@zlib//:zlib"
    ],
    "pixman-1": [
      "@pixman//:pixman-1",
      "@pixman//:pixman_simd"
    ],
    "libfdt": [
      "//third_party/dtc:libfdt"
    ],
    "libpulse": [
      "@pulse//:libpulse"
    ],
    "vhost-user": [
      "//third_party/qemu/subprojects/libvhost-user:vhost-user"
    ],
    "vhost-user-glib": [
      "//third_party/qemu/subprojects/libvhost-user:vhost-user-glib"
    ],
    "rutabaga_gfx_ffi": [
      "@crosvm//:rutabaga_c_ffi"
    ]
  },
  // The actual set of targets you wish to generate bazel targets for.
  // These are the targets that will be exported.
  "export": [
    "qemu-system-x86_64",
    "qemu-system-aarch64",
    "qemu-system-riscv64",
    "qemu-img",
    // Here we have the windows modules:
    "hw-display-virtio-gpu",
    "hw-display-virtio-vga",
    "hw-display-virtio-gpu-pci",
    "hw-display-virtio-gpu-rutabaga",
    "hw-display-virtio-gpu-pci-rutabaga"
  ],
  "exclude": [
    //"vhost-user",
    //"vhost-user-glib",
    // We will provide our own module info that will be build into qemu
    // This will allow us to provide our own custom drivers.
    "modinfo-.*"
  ]
}
