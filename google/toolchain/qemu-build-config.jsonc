{
  // This file configures the build for a Meson-based project. It is used by the
  // generic MesonProjectBuilder to generate toolchains, dependencies, and other
  // necessary build files.
  //
  // The structure is composed of two main sections:
  // 1. "common": Holds configurations that are shared across all target platforms.
  // 2. "platforms": Contains platform-specific configurations that can override
  //    or extend the common settings.
  //
  // # Merging Strategy
  //
  // The builder merges these sections based on the target platform. For example,
  // when building for "linux-x64", the builder will merge the settings from
  // "common" and "platforms.linux-x64". The merging rules are as follows:
  //
  // - Dictionaries (like "dependencies" and "meson_options"): The platform-specific
  //   dictionary is merged into the common one. If there are conflicting keys,
  //   the platform-specific value takes precedence.
  //
  // - Lists of Objects (like "generated_files"): The list from the platform is
  //   appended to the common list. A special deep merge is then performed on
  //   objects that share the same "filename", combining their "content" fields.
  //   This ensures that platform-specific file content supplements, rather than
  //   replaces, common content.
  //
  // # Shims (Rule Overrides)
  //
  // Shims are used to override or modify the Bazel rules generated by the
  // translation process. Since the generator translates Meson build rules
  // directly, sometimes the output needs to be tweaked to work correctly
  // in the Bazel environment (e.g., adding missing dependencies, injecting
  // platform-specific flags, or replacing source files).
  //
  // Shims use regex matching on the generated target names to apply modifications.
  // Supported operations include adding (`+`) or removing (`-`) values from lists
  // like `srcs`, `deps`, `copts`, etc.
  "project_name": "qemu",
  "source_path": "third_party/qemu",
  "common": {
    // "dependencies": A dictionary of libraries required for the build. These
    // are used to generate pkg-config (.pc) files, which Meson uses to find
    // libraries and their headers.
    "dependencies": {
      // Example: This shim renames the package to "rutabaga_gfx_ffi" and
      // specifies a different Bazel target for the library archive.
      "rutabaga_gfx_ffi": {
        "lib_type": "bazel",
        "bazel_target": "@rutabaga_gfx//:rutabaga_c_ffi",
        "version": "0.1.2",
        "shim": {
          "name": "rutabaga_gfx_ffi",
          "archive_target": "@rutabaga_gfx//:rutabaga_ffi"
        }
      },
      "libfdt": {
        "lib_type": "bazel",
        "bazel_target": "@dtc//:libfdt",
        "version": "1.6.0"
      },
      "gmodule": {
        "lib_type": "bazel",
        "bazel_target": "@glib//gmodule",
        "version": "2.77.2",
        "shim": {
          "name": "gmodule-export-2.0",
          "link_flags": "-pthread",
          "Requires": "pcre2"
        }
      },
      "zlib": {
        "lib_type": "bazel",
        "bazel_target": "@zlib//:zlib",
        "version": "1.2.10"
      },
      "glib": {
        "lib_type": "bazel",
        "bazel_target": "@glib//glib",
        "version": "2.77.2",
        "shim": {
          "name": "glib-2.0",
          "Requires": "pcre2, gmodule-export-2.0",
          "link_flags": "-pthread"
        }
      },
      "pixman": {
        "lib_type": "bazel",
        "bazel_target": "@pixman//:pixman-1",
        "version": "0.42.3",
        "shim": {
          "Requires": "pixman_simd"
        }
      },
      "pixman_simd": {
        "lib_type": "bazel",
        "bazel_target": "@pixman//:pixman_simd",
        "version": "0.42.3"
      },
      "pcre2": {
        "lib_type": "bazel",
        "bazel_target": "@pcre2//:pcre2",
        "version": "10.42"
      }
    },
    // "meson_options": A dictionary of Meson feature flags and settings.
    // These are passed to the `meson setup` command.
    "meson_options": {
      "-Daf_xdp": "disabled",
      "-Dalsa": "disabled",
      "-Dandroid": "enabled",
      "-Dasan": "false",
      "-Dattr": "disabled",
      "-Daudio_drv_list": "default",
      "-Dauth_pam": "disabled",
      "-Dauto_features": "disabled",
      "-Davx2": "disabled",
      "-Davx512bw": "disabled",
      "-Db_coverage": "false",
      "-Db_lto": "false",
      "-Db_pie": "false",
      "-Dblkio": "disabled",
      "-Dbochs": "disabled",
      "-Dbpf": "disabled",
      "-Dbrlapi": "disabled",
      "-Dbzip2": "disabled",
      "-Dcanokey": "disabled",
      "-Dcap_ng": "disabled",
      "-Dcapstone": "disabled",
      "-Dcfi": "false",
      "-Dcfi_debug": "false",
      "-Dcloop": "disabled",
      "-Dcocoa": "disabled",
      "-Dcolo_proxy": "disabled",
      "-Dcoreaudio": "disabled",
      "-Dcoroutine_pool": "true",
      "-Dcrypto_afalg": "disabled",
      "-Dcurl": "disabled",
      "-Dcurses": "disabled",
      "-Ddbus_display": "disabled",
      "-Ddebug_graph_lock": "false",
      "-Ddebug_mutex": "false",
      "-Ddebug_remap": "false",
      "-Ddebug_stack_usage": "false",
      "-Ddebug_tcg": "false",
      "-Ddefault_devices": "true",
      "-Ddmg": "disabled",
      "-Ddocs": "disabled",
      "-Ddsound": "disabled",
      "-Dfdt": "enabled",
      "-Dfuse": "disabled",
      "-Dfuse_lseek": "disabled",
      "-Dfuzzing": "false",
      "-Dgcrypt": "disabled",
      "-Dgettext": "disabled",
      "-Dgio": "disabled",
      "-Dglusterfs": "disabled",
      "-Dgnutls": "disabled",
      "-Dgtk": "disabled",
      "-Dgtk_clipboard": "disabled",
      "-Dguest_agent": "disabled",
      "-Dguest_agent_msi": "disabled",
      "-Dhexagon_idef_parser": "false",
      "-Dhv_balloon": "disabled",
      "-Dhvf": "disabled",
      "-Diconv": "disabled",
      "-Dinstall_blobs": "false",
      "-Djack": "disabled",
      "-Dkeyring": "disabled",
      "-Dkvm": "disabled",
      "-Dl2tpv3": "disabled",
      "-Dlibcbor": "disabled",
      "-Dlibdaxctl": "disabled",
      "-Dlibdw": "disabled",
      "-Dlibiscsi": "disabled",
      "-Dlibkeyutils": "disabled",
      "-Dlibnfs": "disabled",
      "-Dlibpmem": "disabled",
      "-Dlibssh": "disabled",
      "-Dlibudev": "disabled",
      "-Dlibusb": "disabled",
      "-Dlibvduse": "disabled",
      "-Dlinux_aio": "disabled",
      "-Dlinux_io_uring": "disabled",
      "-Dlzfse": "disabled",
      "-Dlzo": "disabled",
      "-Dmalloc_trim": "disabled",
      "-Dmembarrier": "disabled",
      "-Dmodule_upgrades": "false",
      "-Dmodules": "disabled",
      "-Dmpath": "disabled",
      "-Dmultiprocess": "disabled",
      "-Dnetmap": "disabled",
      "-Dnettle": "disabled",
      "-Dnuma": "disabled",
      "-Dnvmm": "disabled",
      "-Dopengl": "disabled",
      "-Doss": "disabled",
      "-Dpa": "disabled",
      "-Dparallels": "disabled",
      "-Dpipewire": "disabled",
      "-Dpixman": "enabled",
      "-Dplugins": "false",
      "-Dpng": "disabled",
      "-Dprefer_static": "false",
      "-Dpvg": "disabled",
      "-Dqatzip": "disabled",
      "-Dqcow1": "disabled",
      "-Dqed": "disabled",
      "-Dqga_vss": "disabled",
      "-Dqom_cast_debug": "false",
      "-Dqpl": "disabled",
      "-Drbd": "disabled",
      "-Drdma": "disabled",
      "-Drelocatable": "true",
      "-Dreplication": "disabled",
      "-Drng_none": "false",
      "-Drust": "disabled",
      "-Drutabaga_gfx": "enabled",
      "-Dsafe_stack": "false",
      "-Dsdl": "disabled",
      "-Dsdl_image": "disabled",
      "-Dseccomp": "disabled",
      "-Dselinux": "disabled",
      "-Dslirp": "enabled",
      "-Dslirp_smbd": "disabled",
      "-Dsmartcard": "disabled",
      "-Dsnappy": "disabled",
      "-Dsndio": "disabled",
      "-Dsparse": "disabled",
      "-Dspice": "disabled",
      "-Dspice_protocol": "disabled",
      "-Dstack_protector": "disabled",
      "-Dstrict_rust_lints": "false",
      "-Dtcg": "enabled",
      "-Dtcg_interpreter": "false",
      "-Dtools": "enabled",
      "-Dtpm": "disabled",
      "-Dtrace_backends": "nop",
      "-Dtsan": "false",
      "-Du2f": "disabled",
      "-Duadk": "disabled",
      "-Dubsan": "false",
      "-Dusb_redir": "disabled",
      "-Dvde": "disabled",
      "-Dvdi": "disabled",
      "-Dvduse_blk_export": "disabled",
      "-Dvfio_user_server": "disabled",
      "-Dvhdx": "disabled",
      "-Dvhost_crypto": "disabled",
      "-Dvhost_kernel": "disabled",
      "-Dvhost_net": "disabled",
      "-Dvhost_user": "disabled",
      "-Dvhost_user_blk_server": "disabled",
      "-Dvhost_vdpa": "disabled",
      "-Dvirglrenderer": "disabled",
      "-Dvirtfs": "disabled",
      "-Dvmdk": "disabled",
      "-Dvmnet": "disabled",
      "-Dvnc": "enabled",
      "-Dvnc_jpeg": "disabled",
      "-Dvnc_sasl": "disabled",
      "-Dvpc": "disabled",
      "-Dvte": "disabled",
      "-Dvvfat": "disabled",
      "-Dwerror": "false",
      "-Dwhpx": "disabled",
      "-Daehd": "disabled",
      "-Dxen": "disabled",
      "-Dxen_pci_passthrough": "disabled",
      "-Dxkbcommon": "disabled",
      "-Dzstd": "disabled"
    },
    // "generated_files": A list of files to be generated by the build script.
    // This is primarily used for files like QEMU's `config-host.mak`.
    "generated_files": [
      {
        "filename": "config-host.mak",
        "content": {
          "common": {
            "GENISOIMAGE": "False",
            "TARGET_DIRS": "aarch64-softmmu riscv64-softmmu x86_64-softmmu",
            "CONFIG_DEFAULT_TARGETS": "y"
          }
        }
      }
    ],
    // # The `shim` Object
    //
    // The `shim` object allows for fine-grained control over the generated
    // .pc file, enabling you to override or supplement the information
    // retrieved from the build system (e.g., Bazel).
    //
    // Common `shim` keys include:
    // - "name": Overrides the package name in the .pc file. Useful when the
    //   Bazel target name doesn't match the expected pkg-config name.
    // - "archive_target": Specifies a different Bazel target to get the
    //   library archive (.a, .lib) from.
    // - "include_target": Specifies a different Bazel target to get the
    //   include paths from.
    // - "Requires": Sets the `Requires` field in the .pc file to declare
    //   dependencies on other pkg-config packages.
    // - "link_flags": Appends additional flags to the `Libs` field in the
    //   .pc file (e.g., "-pthread").
    // - "cflags": Appends additional flags to the `Cflags` field.
    // - "Libs": Completely overrides the `Libs` line in the .pc file. This is
    //   useful for system libraries where you only need to provide a flag
    //   like "-lpulse".
    // - "link_name": Creates a symbolic link for the library archive, for
    //   cases where a different filename is expected.
    // - "dll_ext": Overrides the file extension for shared libraries,
    //   primarily for Windows.
    "shims": [
      {
        // This will allow us to select the trace backend through bazel config settings.
        "target": "generate_trace-.*",
        "shims": {
          "restrict_to": "genrule",
          "substitutions": [
            {
              "attribute": "cmd",
              "pattern": "--backend=nop",
              "repl": "--backend=' + TRACE_BACKEND + '"
            },
            {
              "attribute": "cmd_bat",
              "pattern": "--backend=nop",
              "repl": "--backend=' + TRACE_BACKEND + '"
            }
          ]
        }
      },
      {
        // We introduce a new 'goldfish' generator.
        "target": "tracetool",
        "shims": {
          "restrict_to": "py_binary",
          "+srcs": [
            "scripts/tracetool/backend/goldfish.py"
          ]
        }
      },
      {
        // This shim applies to all targets matching this regex
        "target": "qemu-system-.*",
        "shims": {
          // Force the Bazel rule type to be this instead of what the generator inferred.
          "_bzl_type": "cc_interface_binary",
          // This will remove the entry system/main.c from the srcs list.
          "-srcs": [
            "system/main.c"
          ],
          // This will add the entries to the srcs list.
          "+srcs": [
            "google/system/aemu_main.c",
            "google/system/aemu_func_defs.h"
          ]
        }
      },
      {
        "target": "generate_shared_QAPI_source_files",
        "shims": {
          // This will be added to the outs label
          "+outs": [
            "qapi/qapi-features.h",
            "qapi/qapi-features.c"
          ],
          // We replace the cmd, and cmd_bat labels with this instead
          "cmd": "$(location :qapi-gen) -o $(RULEDIR)/qapi -b $(location qapi/qapi-schema.json)",
          "cmd_bat": "$(location :qapi-gen) -o $(RULEDIR)/qapi -b $(location qapi/qapi-schema.json)"
        }
      },
      {
        "target": "generate_config-poison_h",
        "shims": {
          "cmd": "$(location :make-config-poison) $(SRCS) > $(location config-poison.h)",
          "cmd_bat": "$(location :make-config-poison) $(SRCS) > $(location config-poison.h)"
        }
      },
      {
        "target": "keymap-gen",
        "shims": {
          // Restrict this shim to apply ONLY to rules of this type (supports regex).
          "restrict_to": "py_binary",
          // Overwrite the 'data' attribute completely.
          "data": []
        }
      },
      {
        "target": "generate_input-keymap.*",
        "shims": {
          "restrict_to": "genrule",
          // Overwrite the 'srcs' attribute completely (no +/- prefix).
          "srcs": [
            "@keycodemapdb//:data/keymaps.csv"
          ],
          // Overwrite the 'tools' attribute completely.
          "tools": [
            "@keycodemapdb//:keymap-gen"
          ]
        }
      },
      {
        "target": ".*",
        "shims": {
          "restrict_to": "cc_library|cc_binary|cc_interface_binary|objc_library",
          // Overwrite the 'visibility' attribute.
          "visibility": [
            "//visibility:public"
          ],
          // Remove headers matching these regexes from the 'hdrs' attribute.
          "-hdrs": [
            "include/.*",
            "platform/.*",
            "qapi/.*",
            "subprojects/libslirp/.*"
          ],
          "-srcs": [
            "include/.*",
            "platform/.*",
            "qapi/.*\\.h"
          ],
          // Remove include paths matching these regexes from the 'includes' attribute.
          "-includes": [
            "include",
            "platform/.*",
            "trace",
            "subprojects/.*"
          ],
          // Add dependencies to the 'deps' attribute.
          "+deps": [
            ":qemu-headers",
            ":trace_backend_deps"
          ]
        }
      },
      {
        "target": ".*",
        "shims": {
          "restrict_to": "cc_shared_library",
          "visibility": [
            "//visibility:public"
          ]
        }
      },
      {
        "target": ".*",
        "shims": {
          "restrict_to": "cc_library|objc_library",
          // Set 'alwayslink' attribute (1 for true, 0 for false).
          "alwayslink": 1
        }
      },
      {
        "target": "libqemuutil|libprintstub",
        "shims": {
          "alwayslink": 0
        }
      },
      {
        "target": "libqemuutil",
        "shims": {
          "-srcs": [
            "stubs/monitor-core.c",
            "stubs/error-printf.c"
          ],
          "+srcs": [
            "google/drivers/trace/goldfish.c"
          ]
        }
      }
    ],
    "external_deps": {
      "glib-2.0": [
        "@glib//glib"
      ],
      "gmodule-export-2.0": [
        "@glib//gmodule"
      ],
      "zlib": [
        "@zlib//:zlib"
      ],
      "pixman-1": [
        "@pixman//:pixman-1",
        "@pixman//:pixman_simd"
      ],
      "libfdt": [
        "@dtc//:libfdt"
      ],
      "rutabaga_gfx_ffi": [
        "@rutabaga_gfx//:rutabaga_c_ffi"
      ],
      "slirp": ["@libslirp"]
    },
    "export": [
      "qemu-img"
    ],
    "exclude": ["slirp"]
  },
  "platforms": {
    "linux-x64": {
      "dependencies": {
        "libpulse": {
          "lib_type": "bazel",
          "bazel_target": "@gcc_lib//:libpulse",
          "version": "3.0",
          "shim": {
            "Libs": "-lpulse"
          }
        },
        "alsa": {
          "lib_type": "bazel",
          "bazel_target": "@gcc_lib//:libasound",
          "version": "1.0.25",
          "shim": {
            "name": "alsa",
            "Libs": "-lasound"
          }
        },
        "gmodule": {
          "lib_type": "bazel",
          "bazel_target": "@glib//gmodule",
          "version": "2.77.2",
          "shim": {
            "name": "gmodule-export-2.0",
            "link_flags": "-pthread",
            "Requires": "pcre2"
          }
        }
      },
      "meson_options": {
        "-Dandroid": "enabled",
        "-Dalsa": "enabled",
        "-Daudio_drv_list": "pa,alsa",
        "-Davx2": "enabled",
        "-Davx512bw": "enabled",
        "-Db_pie": "true",
        "-Dcrypto_afalg": "enabled",
        "-Dkvm": "enabled",
        "-Dmalloc_trim": "enabled",
        "-Dpa": "enabled",
        "-Dvhost_crypto": "enabled",
        "-Dvhost_kernel": "enabled",
        "-Dvhost_net": "enabled",
        "-Dvhost_user": "enabled",
        "-Dvhost_user_blk_server": "enabled"
      },
      "shims": [
        {
          "target": "qemu-system-.*",
          "shims": {
            "+linkopts": [
              "-rdynamic",
              "-lrt"
            ],
            "+deps": [
              "@gcc_lib//:libpulse"
            ]
          }
        },
        {
          "target": "qemu-img",
          "shims": {
            "+linkopts": [
              "-lrt"
            ]
          }
        },
        {
          "target": ".*",
          "shims": {
            "restrict_to": "cc_library|cc_binary|cc_interface_binary",
            "-hdrs": [
              "subprojects/libvhost-user/.*"
            ],
            "+copts": [
              "-fwrapv",
              "-mcx16",
              "-Wno-implicit-function-declaration"
            ],
            "+deps": [
              "//google/compat/linux:compat"
            ]
          }
        }
      ],
      "external_deps": {
        "alsa": [
          "@gcc_lib//:libasound"
        ],
        "libpulse": [
          "@gcc_lib//:libpulse"
        ],
        "libvhost-user": [
          "//subprojects/libvhost-user:vhost-user"
        ],
        "libvhost-user-glib": [
          "//subprojects/libvhost-user:vhost-user-glib"
        ]
      },
      "export": [
        "qemu-system-x86_64",
        "qemu-system-aarch64",
        "qemu-system-riscv64"
      ],
      "exclude": [
        "vhost-user",
        "vhost-user-glib"
      ]
    },
    "linux-aarch64": {
      "dependencies": {
        "libpulse": {
          "lib_type": "bazel",
          "bazel_target": "@gcc_lib//:libpulse",
          "version": "3.0",
          "shim": {
            "Libs": "-lpulse"
          }
        },
        "alsa": {
          "lib_type": "bazel",
          "bazel_target": "@gcc_lib//:libasound",
          "version": "1.0.25",
          "shim": {
            "name": "alsa",
            "Libs": "-lasound"
          }
        },
        "gmodule": {
          "lib_type": "bazel",
          "bazel_target": "@glib//gmodule",
          "version": "2.77.2",
          "shim": {
            "name": "gmodule-export-2.0",
            "link_flags": "-pthread",
            "Requires": "pcre2"
          }
        }
      }
    },
    "mac-aarch64": {
      "dependencies": {
        "gmodule": {
          "lib_type": "bazel",
          "bazel_target": "@glib//gmodule",
          "version": "2.77.2",
          "shim": {
            "name": "gmodule-export-2.0",
            "link_flags": "-pthread",
            "Requires": "pcre2"
          }
        },
        "glib": {
          "lib_type": "bazel",
          "bazel_target": "@glib//glib",
          "version": "2.77.2",
          "shim": {
            "name": "glib-2.0",
            "Requires": "pcre2, gmodule-export-2.0",
            "link_flags": "-liconv"
          }
        }
      },
      "meson_options": {
        "-Daudio_drv_list": "coreaudio",
        "-Db_pie": "true",
        "-Dcoreaudio": "enabled",
        "-Dhvf": "enabled",
        "-Dvmnet": "enabled"
      },
      "shims": [
        {
          "target": "qemu-system-.*-unsigned",
          "shims": {
            "_bzl_type": "cc_interface_binary",
            "-srcs": [
              "system/main.c"
            ],
            "+srcs": [
              "google/system/aemu_main.c",
              "google/system/aemu_func_defs.h"
            ],
            "+linkopts": [
              "-Wl,-export_dynamic"
            ]
          }
        },
        {
          "target": "qemu-system-aarch64-unsigned",
          "shims": {
            "name": "qemu-system-aarch64"
          }
        },
        {
          "target": "qemu-system-riscv64-unsigned",
          "shims": {
            "name": "qemu-system-riscv64"
          }
        },
        {
          "target": "qemu-system-x86_64-unsigned",
          "shims": {
            "name": "qemu-system-x86_64"
          }
        },
        {
          "target": "libcommon_qemu-system-aarch64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-aarch64"
          }
        },
        {
          "target": "libcommon_qemu-system-riscv64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-riscv64"
          }
        },
        {
          "target": "libcommon_qemu-system-x86_64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-x86_64"
          }
        },
        {
          "target": ".*",
          "shims": {
            "restrict_to": "cc_library|cc_binary|cc_interface_binary|objc_library",
            "+copts": [
              "-fwrapv",
              "-Wno-implicit-function-declaration",
              "-Wno-error=unguarded-availability-new"
            ]
          }
        }
      ],
      "external_deps": {},
      "export": [
        "qemu-system-x86_64-unsigned",
        "qemu-system-aarch64-unsigned",
        "qemu-system-riscv64-unsigned"
      ],
      "exclude": []
    },
    "mac-x64": {
      "dependencies": {
        "gmodule": {
          "lib_type": "bazel",
          "bazel_target": "@glib//gmodule",
          "version": "2.77.2",
          "shim": {
            "name": "gmodule-export-2.0",
            "link_flags": "-pthread",
            "Requires": "pcre2"
          }
        },
        "glib": {
          "lib_type": "bazel",
          "bazel_target": "@glib//glib",
          "version": "2.77.2",
          "shim": {
            "name": "glib-2.0",
            "Requires": "pcre2, gmodule-export-2.0",
            "link_flags": "-liconv"
          }
        }
      },
      "meson_options": {
        "-Daudio_drv_list": "coreaudio",
        "-Db_pie": "true",
        "-Dcoreaudio": "enabled",
        "-Dhvf": "enabled",
        "-Dvmnet": "enabled"
      },
      "shims": [
        {
          "target": "qemu-system-.*-unsigned",
          "shims": {
            "_bzl_type": "cc_interface_binary",
            "-srcs": [
              "system/main.c"
            ],
            "+srcs": [
              "google/system/aemu_main.c",
              "google/system/aemu_func_defs.h"
            ],
            "+linkopts": [
              "-Wl,-export_dynamic"
            ]
          }
        },
        {
          "target": "qemu-system-aarch64-unsigned",
          "shims": {
            "name": "qemu-system-aarch64"
          }
        },
        {
          "target": "qemu-system-riscv64-unsigned",
          "shims": {
            "name": "qemu-system-riscv64"
          }
        },
        {
          "target": "qemu-system-x86_64-unsigned",
          "shims": {
            "name": "qemu-system-x86_64"
          }
        },
        {
          "target": "libcommon_qemu-system-aarch64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-aarch64"
          }
        },
        {
          "target": "libcommon_qemu-system-riscv64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-riscv64"
          }
        },
        {
          "target": "libcommon_qemu-system-x86_64-unsigned",
          "shims": {
            "name": "libcommon_qemu-system-x86_64"
          }
        },
        {
          "target": ".*",
          "shims": {
            "restrict_to": "cc_library|cc_binary|cc_interface_binary|objc_library",
            "+copts": [
              "-fwrapv",
              "-Wno-implicit-function-declaration",
              "-Wno-error=unguarded-availability-new"
            ]
          }
        }
      ],
      "external_deps": {},
      "export": [
        "qemu-system-x86_64-unsigned",
        "qemu-system-aarch64-unsigned",
        "qemu-system-riscv64-unsigned"
      ],
      "exclude": []
    },
    "windows-x64": {
      "dependencies": {
        "gmodule": {
          "lib_type": "bazel",
          "bazel_target": "@glib//gmodule",
          "version": "2.77.2",
          "shim": {
            "name": "gmodule-export-2.0",
            "cflags": "-DGMODULE_STATIC_COMPILATION",
            "Requires": "pcre2"
          }
        },
        "glib": {
          "lib_type": "bazel",
          "bazel_target": "@glib//glib",
          "version": "2.77.2",
          "shim": {
            "name": "glib-2.0",
            "Requires": "pcre2, zlib, gmodule-export-2.0, gnulib, dirent",
            "link_name": "glib-2.0.lib",
            "cflags": "-DGLIB_STATIC_COMPILATION",
            "dll_ext": ""
          }
        },
        "gnulib": {
          "lib_type": "bazel",
          "bazel_target": "@glib//glib:gnulib",
          "version": "2.77.2"
        },
        "dirent": {
          "lib_type": "bazel",
          "bazel_target": "@glib//glib/dirent",
          "version": "2.77.2",
          "shim": {
            "name": "dirent"
          }
        }
      },
      "meson_options": {
        "--vsenv": null,
        "-Daudio_drv_list": "dsound",
        "-Davx2": "auto",
        "-Davx512bw": "auto",
        "-Ddsound": "enabled",
        "-Dvhost_net": "enabled",
        "-Dwhpx": "enabled",
        "-Daehd": "enabled"
      },
      "generated_files": [
        {
          "filename": "config-host.mak",
          "content": {
            "windows-x64": {
              "EXESUF": ".exe"
            }
          }
        }
      ],
      "bazel_prefix": "load(\"@goldfish_build//rules:windows_resources.bzl\", \"windows_manifest_resource\", \"windows_resources\")\nwindows_manifest_resource(name = \"qemu-img_manifest_rc\", binary_filename = \"qemu-img.exe\")\nwindows_manifest_resource(name = \"qemu-system-x86_64_manifest_rc\", binary_filename = \"qemu-system-x86_64.exe\")",
      "shims": [
        {
          "target": "qemu-img",
          "shims": {
            "+deps": [
              ":qemu-img_manifest_rc"
            ]
          }
        },
        {
          "target": "qemu-system-aarch64",
          "shims": {
            "win_def_file": "google/build/qemu-system-aarch64.def"
          }
        },
        {
          "target": "qemu-system-riscv64",
          "shims": {
            "win_def_file": "google/build/qemu-system-riscv64.def"
          }
        },
        {
          "target": "qemu-system-x86_64",
          "shims": {
            "+deps": [
              ":qemu-system-x86_64_manifest_rc"
            ],
            "win_def_file": "google/build/qemu-system-x86_64.def"
          }
        },
        {
          "target": ".*",
          "shims": {
            "restrict_to": "py_binary",
            "imports": [
              "scripts"
            ]
          }
        },
        {
          "target": ".*",
          "shims": {
            "restrict_to": "cc_library|cc_binary|cc_interface_binary",
            "+copts": [
              "-Wno-constant-conversion",
              "-Wno-macro-redefined",
              "-Wno-invalid-noreturn",
              "-Wno-bitfield-constant-conversion",
              "-Wno-int-to-void-pointer-cast",
              "-Wno-unused-command-line-argument",
              "-Wno-undef",
              "-Wno-microsoft-enum-forward-reference",
              "-Wno-microsoft-include",
              "-Wno-deprecated-declarations",
              "-fms-extensions"
            ],
            "+deps": [
              "//google/compat/windows:compat"
            ],
            "+local_defines": [
              "BUILDING_QEMU_BINARY"
            ]
          }
        }
      ],
      "external_deps": {
        "glib-2.0": [
          "@glib//glib",
          "@glib//gmodule"
        ]
      },
      "export": [
        "qemu-system-x86_64",
        "qemu-system-aarch64"
      ],
      "exclude": []
    }
  }
}
