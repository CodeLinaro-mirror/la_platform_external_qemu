{
  "shims": [
    {
      "target": "qemu-system-.*",
      "shims": {
        // Enable our plugins to link back.
        "+linkopts": ["-rdynamic", "-lrt"],
        "+deps": ["@gcc_lib//:libpulse"]
      }
    },
    {
      "target": "qemu-img",
      "shims": {
        "+linkopts": ["-lrt"]
      }
    },
    {
      "target": ".*",
      "shims": {
        "restrict_to": "cc_library|cc_binary|cc_interface_binary",
        // Remove our compat libs if present
        "-hdrs": ["subprojects/libvhost-user/.*"],
        // Our sysroot is too old so we need to introduce these
        "+copts": [
          "-fwrapv",
          // Enables clang to generate CMPXCHG16B instructions.
          "-mcx16",
          // We do not have memfd_create
          "-Wno-implicit-function-declaration"
        ],
        // We need a compat layer for our ye olde sysroot.
        "+deps": [
          "//google/compat/linux:compat"
        ]
      }
    }
  ],
  "external_deps": {
    "alsa": ["@gcc_lib//:libasound"],
    // For some reason Qemu doesn't ask for libpulse. So we add it manually above.
    "libpulse": ["@gcc_lib//:libpulse"],
    "libvhost-user": ["//subprojects/libvhost-user:vhost-user"],
    "libvhost-user-glib": ["//subprojects/libvhost-user:vhost-user-glib"]
  },
  "export": [
    "qemu-system-x86_64",
    "qemu-system-aarch64",
    "qemu-system-riscv64"
  ],
  "exclude": [
    "vhost-user",
    "vhost-user-glib"
  ]
}
